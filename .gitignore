# environment — never commit real tokens
.env

# playwright browser profile — generated at runtime
.playwright/
.cache/

# user configs — contain real Discord IDs, never commit
config/*.json
state.json

# python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/

# file locks from config_loader
*.lock
*.tmp

# secrets and raw demo assets
*.key
*.pem
docs/assets/raw/
*.mov

# OS
.DS_Store
Thumbs.db
